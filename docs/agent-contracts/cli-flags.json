{
  "commands": {
    "agents": {
      "constraints": [
        "Global flags can precede or follow the command. A separate CLI call creates a new browser context; --profile and storage state persist authentication, not page state.",
        "Query a subcommand: gomoufox help agents install --json --fields flag_schema."
      ],
      "usage": "gomoufox agents <install> [flags]"
    },
    "agents install": {
      "constraints": [
        "Global flags can precede or follow the command. A separate CLI call creates a new browser context; --profile and storage state persist authentication, not page state."
      ],
      "flags": {
        "dry-run": {
          "default": false,
          "type": "boolean"
        },
        "features": {
          "default": "skills,mcp",
          "enum": [
            "skills",
            "mcp"
          ],
          "format": "csv",
          "notes": "Enum applies to each CSV item.",
          "type": "string"
        },
        "force": {
          "default": false,
          "type": "boolean"
        },
        "mcp-arg": {
          "default": "",
          "repeat": true,
          "type": "string"
        },
        "scope": {
          "default": "user",
          "enum": [
            "user",
            "project"
          ],
          "type": "string"
        },
        "target": {
          "default": "all",
          "enum": [
            "codex",
            "claude",
            "cursor",
            "gemini",
            "all"
          ],
          "type": "string"
        },
        "toolset": {
          "default": "core",
          "enum": [
            "core",
            "full"
          ],
          "type": "string"
        }
      },
      "usage": "gomoufox agents install [--target codex|claude|cursor|gemini|all] [--scope user|project] [--features skills,mcp] [--toolset core] [--mcp-arg <arg>] [--force] [--dry-run] [--json]"
    },
    "doctor": {
      "constraints": [
        "Global flags can precede or follow the command. A separate CLI call creates a new browser context; --profile and storage state persist authentication, not page state."
      ],
      "flags": {
        "dir": {
          "default": "",
          "default_source": "OS cache directory/gomoufox/venv; see doctor.",
          "format": "path",
          "type": "string"
        },
        "runtime": {
          "default": "node-direct",
          "enum": [
            "node-direct",
            "python"
          ],
          "type": "string"
        }
      },
      "usage": "gomoufox doctor [--dir path] [--runtime node-direct|python] [--json]"
    },
    "eval": {
      "constraints": [
        "Global flags can precede or follow the command. A separate CLI call creates a new browser context; --profile and storage state persist authentication, not page state.",
        "Requires --enable-eval and exactly one of --script or --script-file. --arg and --arg-file are mutually exclusive; the script must be a function to receive its JSON argument."
      ],
      "flags": {
        "arg": {
          "default": "",
          "format": "json",
          "max_bytes": 245760,
          "notes": "Passed to a function parameter; no global arg is created. Excludes --arg-file.",
          "type": "string"
        },
        "arg-file": {
          "default": "",
          "format": "path",
          "max_bytes": 245760,
          "notes": "File contents must be JSON.",
          "type": "string"
        },
        "enable-eval": {
          "default": false,
          "type": "boolean"
        },
        "height": {
          "default": 800,
          "maximum": 100000,
          "minimum": 1,
          "notes": "Default applies when either viewport flag is supplied; otherwise use the browser context default.",
          "type": "integer",
          "units": "CSS pixels"
        },
        "script": {
          "default": "",
          "format": "javascript",
          "max_bytes": 65536,
          "type": "string"
        },
        "script-file": {
          "default": "",
          "format": "path",
          "max_bytes": 65536,
          "type": "string"
        },
        "wait-load-state": {
          "default": "domcontentloaded",
          "enum": [
            "domcontentloaded",
            "load",
            "networkidle"
          ],
          "type": "string"
        },
        "wait-selector": {
          "default": "",
          "format": "css-selector",
          "type": "string"
        },
        "width": {
          "default": 1280,
          "maximum": 100000,
          "minimum": 1,
          "notes": "Default applies when either viewport flag is supplied; otherwise use the browser context default.",
          "type": "integer",
          "units": "CSS pixels"
        }
      },
      "usage": "gomoufox eval <url> --enable-eval (--script <js>|--script-file <path>)"
    },
    "fetch": {
      "constraints": [
        "Global flags can precede or follow the command. A separate CLI call creates a new browser context; --profile and storage state persist authentication, not page state.",
        "--data and --data-file are mutually exclusive. Multipart excludes those body flags and Content-Type overrides. --out excludes --max-bytes and --raw; --max-file-bytes and --overwrite require --out. --cookies-file excludes --profile."
      ],
      "flags": {
        "content-type": {
          "default": "",
          "type": "string"
        },
        "cookies-file": {
          "default": "",
          "format": "path",
          "type": "string"
        },
        "data": {
          "default": "",
          "max_bytes": 1048576,
          "type": "string"
        },
        "data-file": {
          "default": "",
          "format": "path",
          "max_bytes": 52428800,
          "type": "string"
        },
        "form": {
          "default": "",
          "format": "name=value",
          "max_items": 128,
          "notes": "Complete multipart body is limited to 50 MiB.",
          "repeat": true,
          "type": "string"
        },
        "form-file": {
          "default": "",
          "format": "name=path",
          "max_bytes": 52428800,
          "max_items": 32,
          "notes": "Complete multipart body is limited to 50 MiB.",
          "repeat": true,
          "type": "string"
        },
        "header": {
          "default": "",
          "format": "name:value",
          "repeat": true,
          "type": "string"
        },
        "max-bytes": {
          "default": 524288,
          "maximum": 524288,
          "minimum": 1,
          "type": "integer",
          "units": "bytes"
        },
        "max-file-bytes": {
          "default": 52428800,
          "maximum": 52428800,
          "minimum": 1,
          "type": "integer",
          "units": "bytes"
        },
        "method": {
          "default": "GET",
          "enum": [
            "GET",
            "POST",
            "PUT",
            "PATCH",
            "DELETE",
            "HEAD"
          ],
          "notes": "Case-insensitive. Multipart defaults to POST.",
          "type": "string"
        },
        "navigate-first": {
          "default": "",
          "format": "url",
          "type": "string"
        },
        "out": {
          "default": "",
          "format": "path",
          "type": "string"
        },
        "overwrite": {
          "default": false,
          "type": "boolean"
        },
        "raw": {
          "default": false,
          "notes": "With --json, keeps body as a string inside the JSON envelope. Without --json, stdout is already body bytes. Excludes --out.",
          "type": "boolean"
        }
      },
      "usage": "gomoufox fetch <url> [--method GET] [--data <text>] [--navigate-first <url>]"
    },
